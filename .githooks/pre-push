#!/bin/sh
set -eu
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_sha" in
        0000000000000000000000000000000000000000) continue ;;
    esac
    if command -v py >/dev/null 2>&1; then
        py -3 scripts/check_privacy.py --history "$local_sha"
    elif command -v python3 >/dev/null 2>&1; then
        python3 scripts/check_privacy.py --history "$local_sha"
    elif command -v python >/dev/null 2>&1; then
        python scripts/check_privacy.py --history "$local_sha"
    else
        printf '%s\n' 'Python 3 is required for the repository privacy check.' >&2
        exit 1
    fi
done
